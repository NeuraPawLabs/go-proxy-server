# Systemd service file for go-proxy-server
# Prefer installing this unit through the CLI instead of copying it manually.
# `service install` installs the binary to /usr/local/bin/go-proxy-server,
# creates the runtime config if it is missing, reloads systemd, and starts
# the service.
#
# Installation:
# 1. Build the binary: make build
# 2. Install the service: sudo ./bin/go-proxy-server service install
#
# For local build deployment, use go-proxy-server-local.service instead

[Unit]
Description=Go Proxy Server (SOCKS5 and HTTP)
After=network.target

[Service]
Type=simple
User=root
Environment=HOME=/root
WorkingDirectory=/root
ExecStart=/usr/local/bin/go-proxy-server run -config /root/.config/go-proxy-server/config.toml
Restart=always
RestartSec=5
StandardOutput=append:/var/log/go-proxy-server.log
StandardError=append:/var/log/go-proxy-server-error.log

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=65535

# Graceful shutdown
TimeoutStopSec=10
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
